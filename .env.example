# AppCategorizer — LLM provider API keys
# Copy this file to .env and fill in the keys for the providers you use.
# Alternatively, pass keys directly with --api-key on the command line.
#
# Key resolution order for each call:
#   1. --api-key CLI argument (or llm_api_key Python parameter)
#   2. The environment variable listed below
#   3. This .env file (loaded automatically if python-dotenv is installed)

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Used with: --llm-provider openai
OPENAI_API_KEY=sk-...

# ── Anthropic ────────────────────────────────────────────────────────────────
# Used with: --llm-provider anthropic
ANTHROPIC_API_KEY=sk-ant-...

# ── Mistral AI ───────────────────────────────────────────────────────────────
# Used with: --llm-provider mistral
MISTRAL_API_KEY=...

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Used with: --llm-provider gemini
# GOOGLE_API_KEY is accepted as a fallback if GEMINI_API_KEY is not set.
GEMINI_API_KEY=...
# GOOGLE_API_KEY=...

# ── Custom / self-hosted OpenAI-compatible endpoint ───────────────────────────
# Used with: --llm-provider custom --llm-base-url http://my-server/v1
LLM_API_KEY=...

# ── Ollama (local, no key required) ───────────────────────────────────────────
# Ollama needs no API key. Override the base URL if your instance is not on
# the default port:
#   appcategorizer MyApp --mode cloud_llm --llm-provider ollama \
#                        --llm-base-url http://localhost:11434/v1

# ── GitHub (optional, for the local_ml resolver) ─────────────────────────────
# Increases GitHub API rate limits when querying metadata sources.
# GITHUB_TOKEN=ghp_...
